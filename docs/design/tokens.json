      "neutro/500": "#85868F",
      "neutro/600": "#666666",
      "noite/text": "#ECECF4",
      "noite/text-muted": "#A9AAB8",
      "noite/border-strong": "#6E7090",
      "noite/border": "#3A3D5C",
      "noite/sidebar": "#2D2F52",
      "noite/surface-2": "#2D3047",
      "noite/surface": "#22243A",
      "noite/app": "#17182A",
      "noite/deep": "#14152A",
      "vermelho/100": "#FBE4E0",
      "vermelho/200": "#F4A89A",
      "vermelho/300": "#F0907F",
      "vermelho/500": "#EB472E",
      "vermelho/600": "#B5443A",
      "vermelho/700": "#8F3028",
      "vermelho/950": "#3D1A17",
      "verde/100": "#DDF1E6",
      "verde/300": "#74C69D",
      "verde/700": "#2D6A4F",
      "verde/950": "#16302A",
      "divertida/verde": "#CAE7B9",
      "divertida/areia": "#F3DE8A",
      "divertida/salmao": "#EB9486",
      "divertida/ardosia": "#7E7F9A"
    },
    "semantic": {
      "bg/app":                 { "css": "--color-bg-app",                 "light": "#F1F1F4", "dark": "#17182A", "ref": { "light": "neutro/100",   "dark": "noite/app" } },
      "bg/surface":             { "css": "--color-bg-surface",             "light": "#FFFFFF", "dark": "#22243A", "ref": { "light": "neutro/0",     "dark": "noite/surface" } },
      "bg/subtle":              { "css": "--color-bg-subtle",              "light": "#F7F7F7", "dark": "#2D3047", "ref": { "light": "neutro/50",    "dark": "noite/surface-2" } },
      "bg/hover":               { "css": "--color-bg-hover",               "light": "#F1F1F4", "dark": "#2D3047", "ref": { "light": "neutro/100",   "dark": "noite/surface-2" } },
      "bg/sidebar":             { "css": "--color-bg-sidebar",             "light": "#8284BD", "dark": "#2D2F52", "ref": { "light": "lavanda/500",  "dark": "noite/sidebar" } },
      "bg/sidebar-active":      { "css": "--color-bg-sidebar-active",      "light": "#FFFFFF", "dark": "#8284BD", "ref": { "light": "neutro/0",     "dark": "lavanda/500" }, "note": "item hover da sidebar = este token com 40% de opacidade" },
      "bg/overlay":             { "css": "--color-bg-overlay",             "light": "#2D3047", "dark": "#14152A", "ref": { "light": "tinta/900",    "dark": "noite/deep" }, "note": "usar com 60% de opacidade atrás de modais" },
      "bg/brand-subtle":        { "css": "--color-bg-brand-subtle",        "light": "#E6E6F5", "dark": "#2D2F52", "ref": { "light": "lavanda/100",  "dark": "noite/sidebar" } },
      "text/primary":           { "css": "--color-text-primary",           "light": "#2D3047", "dark": "#ECECF4", "ref": { "light": "tinta/900",    "dark": "noite/text" } },
      "text/muted":             { "css": "--color-text-muted",             "light": "#666666", "dark": "#A9AAB8", "ref": { "light": "neutro/600",   "dark": "noite/text-muted" } },
      "text/on-action":         { "css": "--color-text-on-action",         "light": "#FFFFFF", "dark": "#14152A", "ref": { "light": "neutro/0",     "dark": "noite/deep" } },
      "text/on-sidebar":        { "css": "--color-text-on-sidebar",        "light": "#1B1D33", "dark": "#ECECF4", "ref": { "light": "tinta/950",    "dark": "noite/text" } },
      "text/on-sidebar-active": { "css": "--color-text-on-sidebar-active", "light": "#2D3047", "dark": "#14152A", "ref": { "light": "tinta/900",    "dark": "noite/deep" } },
      "text/on-accent":         { "css": "--color-text-on-accent",         "light": "#2D3047", "dark": "#2D3047", "ref": { "light": "tinta/900",    "dark": "tinta/900" } },
      "text/link":              { "css": "--color-text-link",              "light": "#5A5C9A", "dark": "#B4B6E6", "ref": { "light": "lavanda/700",  "dark": "lavanda/300" } },
      "text/danger":            { "css": "--color-text-danger",            "light": "#8F3028", "dark": "#F0907F", "ref": { "light": "vermelho/700", "dark": "vermelho/300" } },
      "text/success":           { "css": "--color-text-success",           "light": "#2D6A4F", "dark": "#74C69D", "ref": { "light": "verde/700",    "dark": "verde/300" } },
      "text/warning":           { "css": "--color-text-warning",           "light": "#7A5C0E", "dark": "#F3D38A", "ref": { "light": "areia/800",    "dark": "areia/400" } },
      "border/default":         { "css": "--color-border-default",         "light": "#DCDCE4", "dark": "#3A3D5C", "ref": { "light": "neutro/200",   "dark": "noite/border" }, "note": "divisórias e contorno de cards (decorativo)" },
      "border/strong":          { "css": "--color-border-strong",          "light": "#85868F", "dark": "#6E7090", "ref": { "light": "neutro/500",   "dark": "noite/border-strong" }, "note": "borda de inputs e botões secundários (≥ 3:1)" },
      "border/focus":           { "css": "--color-border-focus",           "light": "#5A5C9A", "dark": "#B4B6E6", "ref": { "light": "lavanda/700",  "dark": "lavanda/300" }, "note": "anel de foco 2 px" },
      "border/focus-on-sidebar": { "css": "--color-border-focus-on-sidebar", "light": "#1B1D33", "dark": "#ECECF4", "ref": { "light": "tinta/950", "dark": "noite/text" }, "note": "anel de foco sobre a sidebar; contraste 4,71:1 (claro) e 10,90:1 (escuro)" },
      "action/primary":         { "css": "--color-action-primary",         "light": "#68754F", "dark": "#9AAA74", "ref": { "light": "oliva/500",    "dark": "oliva/300" } },
      "action/primary-hover":   { "css": "--color-action-primary-hover",   "light": "#55613F", "dark": "#AEBD88", "ref": { "light": "oliva/700",    "dark": "oliva/200" } },
      "action/danger":          { "css": "--color-action-danger",          "light": "#B5443A", "dark": "#F0907F", "ref": { "light": "vermelho/600", "dark": "vermelho/300" } },
      "action/danger-hover":    { "css": "--color-action-danger-hover",    "light": "#8F3028", "dark": "#F4A89A", "ref": { "light": "vermelho/700", "dark": "vermelho/200" } },
      "brand/primary":          { "css": "--color-brand-primary",          "light": "#8284BD", "dark": "#8284BD", "ref": { "light": "lavanda/500",  "dark": "lavanda/500" } },
      "brand/accent":           { "css": "--color-brand-accent",           "light": "#F3D38A", "dark": "#F3D38A", "ref": { "light": "areia/400",    "dark": "areia/400" } },
      "feedback/danger":        { "css": "--color-feedback-danger",        "light": "#B5443A", "dark": "#F0907F", "ref": { "light": "vermelho/600", "dark": "vermelho/300" } },
      "feedback/danger-bg":     { "css": "--color-feedback-danger-bg",     "light": "#FBE4E0", "dark": "#3D1A17", "ref": { "light": "vermelho/100", "dark": "vermelho/950" } },
      "feedback/success":       { "css": "--color-feedback-success",       "light": "#2D6A4F", "dark": "#74C69D", "ref": { "light": "verde/700",    "dark": "verde/300" } },
      "feedback/success-bg":    { "css": "--color-feedback-success-bg",    "light": "#DDF1E6", "dark": "#16302A", "ref": { "light": "verde/100",    "dark": "verde/950" } },
      "feedback/warning-bg":    { "css": "--color-feedback-warning-bg",    "light": "#FBF1D6", "dark": "#3A3220", "ref": { "light": "areia/100",    "dark": "areia/950" } }
