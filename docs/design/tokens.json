    "title":       { "size": 24, "lineHeight": 32, "weight": 600, "figma": "Título" },
    "subtitle":    { "size": 18, "lineHeight": 26, "weight": 600, "figma": "Subtítulo" },
    "body":        { "size": 14, "lineHeight": 20, "weight": 400, "figma": "Corpo" },
